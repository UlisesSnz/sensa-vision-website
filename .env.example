NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_ENV=development
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-31
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Enable only after the dataset's Sync Tag Invalidate Function is deployed and verified.
SANITY_SERVER_REVALIDATION_ENABLED=false
SANITY_REVALIDATE_TAGS_SECRET=

# Private credentials for SensaVision Desktop releases. Never prefix these with
# NEXT_PUBLIC_. Use an R2 object token scoped only to sensa-desktop-releases.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sensa-desktop-releases
R2_PUBLIC_BASE_URL=https://downloads.example.com
