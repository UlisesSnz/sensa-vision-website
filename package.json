{
  "name": "schema-ui-next-js-sanity-starter",
  "version": "0.4.1",
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "prei18n:backup": "node -e \"require('node:fs').mkdirSync('backups',{recursive:true})\"",
    "i18n:backup": "sanity dataset export production backups/sensa-pre-i18n.tar.gz",
    "i18n:migrate:dry": "node --env-file=.env.local scripts/migrate-i18n.mjs",
    "i18n:migrate:apply": "node --env-file=.env.local scripts/migrate-i18n.mjs --apply --backup-confirmed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
